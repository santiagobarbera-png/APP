{
  "name": "dating-app",
  "version": "1.0.0",
  "description": "A full-stack dating app with AI matching capabilities.",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "test": "jest --forceExit",
    "lint": "eslint backend/ APP/scripts/ --ext .js",
    "build": "echo 'Backend build complete'",
    "find:perfect-matches": "node APP/scripts/findPerfectMatches.js",
    "send:notifications": "node APP/scripts/sendNotifications.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "express-rate-limit": "^8.3.0",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.7.1",
    "socket.io": "^3.1.1"
  },
  "devDependencies": {
    "eslint": "^7.14.0",
    "jest": "^27.0.0",
    "nodemon": "^2.0.7",
    "supertest": "^6.1.3"
  },
  "keywords": [
    "dating",
    "social",
    "ai",
    "matching"
  ],
  "author": "santiagobarbera-png",
  "license": "ISC",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
